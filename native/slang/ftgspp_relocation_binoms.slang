[ForceInline]
float ftgspp_relocation_binom(uint n, uint k)
{
    const uint mirrored_k = min(k, n - k);
    const uint half_n = n >> 1u;
    const uint row_offset = (n & 1u) == 0u
        ? half_n * (half_n + 1u)
        : (half_n + 1u) * (half_n + 1u);
    return asfloat(FTGSPP_RELOCATION_BINOM_BITS[row_offset + mirrored_k]);
}

